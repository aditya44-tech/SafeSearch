generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReportStatus {
  pending
  analyzed
  acknowledged
  resolved
}

enum RiskLevel {
  high
  medium
  low
}

model SafetyReport {
  id                     Int          @id @default(autoincrement())
  reportText             String
  site                   String
  reporterRole           String?
  isAnonymous            Boolean     @default(false)
  reportedAt             DateTime     @default(now())
  status                 ReportStatus @default(pending)
  riskLevel              RiskLevel?
  hazardCategory         String?
  justification          String?
  analyzedAt             DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  photoUrl               String?
  originalLanguage       String?
  clusterId              String?
  humanOverrideRiskLevel RiskLevel?
  overrideReason         String?
  overriddenBy           String?
  slaDeadline            DateTime?
  keyPhrases             String?  // JSON array of key phrases that drove the risk assessment
  smsSentAt              DateTime?

  sifPotential           String?
  sifReasoning           String?
  sifConfidence          Float?
  humanOverrideSifPotential String?
  sifOverrideReason      String?
  sifOverriddenBy        String?

  organizationId         Int?
  organization           Organization? @relation(fields: [organizationId], references: [id])

  auditLogs              AuditLog[]
  tasks                  Task[]
  complianceMappings     ComplianceMapping[]

  @@index([status])
  @@index([riskLevel])
  @@index([site])
  @@index([reportedAt])
  @@index([clusterId])
}

model AuditLog {
  id          Int          @id @default(autoincrement())
  reportId    Int
  report      SafetyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  action      String
  performedBy String
  timestamp   DateTime     @default(now())
  details     String?

  @@index([reportId])
  @@index([timestamp])
}

model SiteScore {
  id                 Int      @id @default(autoincrement())
  site               String   @unique
  totalReports       Int      @default(0)
  highRiskCount      Int      @default(0)
  avgResolutionHours Float    @default(0)
  scoreValue         Float    @default(100)
  organizationId     Int?
  organization       Organization? @relation(fields: [organizationId], references: [id])
  updatedAt          DateTime @updatedAt

  @@index([site])
  @@index([scoreValue])
}

enum TaskStatus {
  open
  in_progress
  done
  cancelled
}

enum TaskPriority {
  urgent
  high
  normal
  low
}

model Task {
  id          Int          @id @default(autoincrement())
  reportId    Int
  report      SafetyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  title       String
  description String?
  assignedTo  String
  status      TaskStatus   @default(open)
  priority    TaskPriority @default(normal)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([reportId])
  @@index([assignedTo])
  @@index([status])
  @@index([priority])
}

model Organization {
  id            Int              @id @default(autoincrement())
  name          String           @unique
  createdAt     DateTime         @default(now())
  reports       SafetyReport[]
  siteScores    SiteScore[]
  smsRecipients SmsRecipient[]
}

model SmsRecipient {
  id             Int      @id @default(autoincrement())
  hazardCategory String
  phone          String
  name           String?
  isActive       Boolean  @default(true)
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([hazardCategory])
}

model ComplianceReference {
  id                 Int      @id @default(autoincrement())
  hazardCategory     String
  regulationName     String
  sectionReference   String
  description        String
  framework          String?  // e.g. "Oil Mines Regulations, 2017", "OISD-116"
  standardCode       String?  // e.g. "OMR-2017-R34", "OISD-116"
  title              String?  // Full title of the regulation/standard
  applicableActivity String?  // e.g. "Drilling", "Production", "Pipeline Operations"
  requirements       String?  // JSON array of specific requirements
  source             String?  // e.g. "Ministry of Labour & Employment"
  lastVerified       DateTime?
  isVerified         Boolean  @default(false)
  verifiedBy         String?
  verifiedAt         DateTime?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime?

  mappings           ComplianceMapping[]

  @@index([hazardCategory])
  @@index([framework])
  @@index([applicableActivity])
}

model ComplianceMapping {
  id                  Int      @id @default(autoincrement())
  reportId            Int
  report              SafetyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  referenceId         Int?
  reference           ComplianceReference? @relation(fields: [referenceId], references: [id], onDelete: SetNull)
  aiSuggestedRefId    Int?
  aiActivityContext   String?  // AI-detected activity/facility type
  aiExplanation       String?  // AI explanation of why this regulation applies
  aiRecommendedControl String? // AI-recommended control measure
  verifiedMappingId   Int?     // Admin-verified reference (if different from AI)
  verifiedBy          String?
  verifiedAt          DateTime?
  correctionHistory   String?  // JSON array of past corrections
  disclaimerShown     Boolean @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([reportId])
  @@index([referenceId])
  @@index([verifiedMappingId])
}
