generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReportStatus {
  pending
  analyzed
  acknowledged
  resolved
}

enum RiskLevel {
  high
  medium
  low
}

model SafetyReport {
  id                     Int          @id @default(autoincrement())
  reportText             String
  site                   String
  reporterRole           String?
  isAnonymous            Boolean     @default(false)
  reportedAt             DateTime     @default(now())
  status                 ReportStatus @default(pending)
  riskLevel              RiskLevel?
  hazardCategory         String?
  justification          String?
  analyzedAt             DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  photoUrl               String?
  originalLanguage       String?
  clusterId              String?
  humanOverrideRiskLevel RiskLevel?
  overrideReason         String?
  overriddenBy           String?
  slaDeadline            DateTime?
  keyPhrases             String?  // JSON array of key phrases that drove the risk assessment

  organizationId         Int?
  organization           Organization? @relation(fields: [organizationId], references: [id])

  auditLogs              AuditLog[]
  tasks                  Task[]

  @@index([status])
  @@index([riskLevel])
  @@index([site])
  @@index([reportedAt])
  @@index([clusterId])
}

model AuditLog {
  id          Int          @id @default(autoincrement())
  reportId    Int
  report      SafetyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  action      String
  performedBy String
  timestamp   DateTime     @default(now())
  details     String?

  @@index([reportId])
  @@index([timestamp])
}

model SiteScore {
  id                 Int      @id @default(autoincrement())
  site               String   @unique
  totalReports       Int      @default(0)
  highRiskCount      Int      @default(0)
  avgResolutionHours Float    @default(0)
  scoreValue         Float    @default(100)
  organizationId     Int?
  organization       Organization? @relation(fields: [organizationId], references: [id])
  updatedAt          DateTime @updatedAt

  @@index([site])
  @@index([scoreValue])
}

enum TaskStatus {
  open
  in_progress
  done
  cancelled
}

enum TaskPriority {
  urgent
  high
  normal
  low
}

model Task {
  id          Int          @id @default(autoincrement())
  reportId    Int
  report      SafetyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  title       String
  description String?
  assignedTo  String
  status      TaskStatus   @default(open)
  priority    TaskPriority @default(normal)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([reportId])
  @@index([assignedTo])
  @@index([status])
  @@index([priority])
}

model Organization {
  id        Int              @id @default(autoincrement())
  name      String           @unique
  createdAt DateTime         @default(now())
  reports   SafetyReport[]
  siteScores SiteScore[]
}

model ComplianceReference {
  id              Int    @id @default(autoincrement())
  hazardCategory  String
  regulationName  String
  sectionReference String
  description     String

  @@index([hazardCategory])
}
